{
  "name": "music-label-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "start": "npm run start --workspace=apps/web",
    "start:api": "npm run start --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/web",
    "verify": "npm run lint --workspace=apps/web && npx tsc --noEmit --project apps/web/tsconfig.json && npm run type-check --workspace=apps/api && npm run build --workspace=apps/web"
  }
}
